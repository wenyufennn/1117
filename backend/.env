$pgUser = "postgres"        # <-- PostgreSQL 使用者
$pgPass = "BX101240es"    # <-- PostgreSQL 密碼
$pgHost = "localhost"     # 若是遠端請改成 IP 或域名
$pgPort = "5432"
$pgDb   = "se1117"          # <-- 資料庫名稱
$envPath = "backend\.env"
@"
SQLALCHEMY_DATABASE_URL=postgresql+psycopg2://$pgUser:$pgPass@$pgHost:$pgPort/$pgDb
APP_HOST=127.0.0.1
APP_PORT=8000
"@ | Set-Content -Path $envPath -Encoding UTF8
Write-Host "`n✅ .env 已寫入 PostgreSQL DSN（$envPath）"